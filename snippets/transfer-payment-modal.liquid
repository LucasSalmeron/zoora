{% comment %}
  Opens when the customer presses any checkout button (cart page, cart drawer, cart notification)
  or the product page "Comprar ahora" button. For "Comprar ahora" the product is added to the cart
  first, so every path ends in the cart checkout; if the modal is closed, the cart is restored.
  The transfer discount itself comes from the Scala Discounts app: its (hidden) button applies
  the discount and leaves only the transfer payment method in checkout. Mode is set in theme
  settings (Cart):
  - payment: ask how they will pay; "Transferencia" goes through Scala, the other option
    continues to the normal checkout.
  - code: ask for a discount code. settings.transfer_modal_code unlocks paying by transfer with
    the Scala discount; any other code is applied to the cart as a regular Shopify code.
  If Scala is not on the page, checkout works as usual.
{% endcomment %}

{%- assign transfer_fallback_percent = 10 -%}

<dialog
  id="TransferModal"
  class="transfer-modal"
  data-view="{{ settings.transfer_modal_mode }}"
  aria-labelledby="TransferModal-Title"
>
  <div class="transfer-modal__content">
    <button type="button" class="transfer-modal__close" data-transfer-close aria-label="Cerrar">
      <svg viewBox="0 0 18 18" width="18" height="18" aria-hidden="true">
        <path d="M2 2l14 14M16 2L2 16" stroke="currentColor" stroke-width="1.5" fill="none"/>
      </svg>
    </button>

    <h2 id="TransferModal-Title" class="transfer-modal__title">
      <span data-payment-only>¿Cómo querés pagar?</span>
      <span data-code-only>¿Tenés un código de descuento?</span>
    </h2>

    <form class="transfer-modal__code" data-transfer-code-form data-code-only>
      <label for="TransferModal-Code" class="visually-hidden">Código de descuento</label>
      <input
        id="TransferModal-Code"
        class="transfer-modal__code-input"
        type="text"
        name="discount"
        placeholder="Código de descuento"
        autocomplete="off"
        autocapitalize="characters"
      >
      <button type="submit" class="transfer-modal__code-button">Aplicar</button>
    </form>
    <p class="transfer-modal__code-message" data-transfer-code-message data-code-only role="status"></p>

    <button
      type="button"
      class="transfer-modal__option transfer-modal__option--featured"
      data-transfer-choice="transfer"
    >
      <span class="transfer-modal__badge"><span data-transfer-percent>{{ transfer_fallback_percent }}</span>% OFF</span>
      <span class="transfer-modal__label">
        <span data-payment-only>Transferencia bancaria</span>
        <span data-code-only>Pagar por transferencia</span>
      </span>
      <span class="transfer-modal__price">
        <s data-transfer-original></s>
        <strong data-transfer-discounted></strong>
      </span>
    </button>

    <button type="button" class="transfer-modal__option" data-transfer-choice="other">
      <span class="transfer-modal__label">
        <span data-payment-only>Tarjeta, Mercado Pago u otros medios</span>
        <span data-code-only>Continuar al pago</span>
      </span>
      <span class="transfer-modal__price">
        <s data-transfer-full-original></s>
        <strong data-transfer-full></strong>
      </span>
    </button>
  </div>
</dialog>

{% style %}
  scala-cart-button {
    display: none !important;
  }

  .transfer-modal[data-view='payment'] [data-code-only],
  .transfer-modal[data-view='code'] [data-payment-only],
  .transfer-modal[data-view='code']:not([data-code-valid]) [data-transfer-choice='transfer'] {
    display: none !important;
  }

  .transfer-modal {
    width: calc(100% - 32px);
    max-width: 440px;
    padding: 0;
    border: none;
    border-radius: 8px;
    background: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
  }

  .transfer-modal::backdrop {
    background: rgba(0, 0, 0, 0.5);
  }

  .transfer-modal__content {
    position: relative;
    padding: 32px 24px 24px;
  }

  .transfer-modal__close {
    position: absolute;
    top: 12px;
    right: 12px;
    padding: 8px;
    border: none;
    background: none;
    color: inherit;
    cursor: pointer;
  }

  .transfer-modal__title {
    margin: 0 0 20px;
    font-size: 2rem;
    text-align: center;
  }

  .transfer-modal__code {
    display: flex;
    gap: 8px;
  }

  .transfer-modal__code-input {
    flex: 1;
    min-width: 0;
    padding: 10px 12px;
    border: 1px solid rgba(var(--color-foreground), 0.25);
    border-radius: 6px;
    background: none;
    color: inherit;
    font: inherit;
    font-size: 1.4rem;
  }

  .transfer-modal__code-button {
    padding: 10px 16px;
    border: 1px solid rgb(var(--color-foreground));
    border-radius: 6px;
    background: none;
    color: inherit;
    font: inherit;
    font-size: 1.4rem;
    cursor: pointer;
  }

  .transfer-modal__code-message {
    margin: 6px 0 0;
    font-size: 1.3rem;
    color: rgba(var(--color-foreground), 0.75);
  }

  .transfer-modal__code-message:empty {
    display: none;
  }

  .transfer-modal__option {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
    width: 100%;
    margin-top: 12px;
    padding: 16px;
    border: 1px solid rgba(var(--color-foreground), 0.25);
    border-radius: 6px;
    background: none;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition: border-color 0.2s ease;
  }

  .transfer-modal__option:hover {
    border-color: rgb(var(--color-foreground));
  }

  .transfer-modal__option--featured {
    border: 2px solid rgb(var(--color-foreground));
  }

  .transfer-modal__option[disabled] {
    opacity: 0.6;
    cursor: wait;
  }

  .transfer-modal__badge {
    position: absolute;
    top: 14px;
    right: 14px;
    padding: 2px 8px;
    border-radius: 4px;
    background: rgb(var(--color-foreground));
    color: rgb(var(--color-background));
    font-size: 1.2rem;
    letter-spacing: 0.05rem;
  }

  .transfer-modal__label {
    font-size: 1.5rem;
    letter-spacing: 0.04rem;
  }

  .transfer-modal__price {
    display: flex;
    gap: 8px;
    font-size: 1.4rem;
    color: rgba(var(--color-foreground), 0.75);
  }

  .transfer-modal__price strong {
    color: rgb(var(--color-foreground));
  }
{% endstyle %}

<script>
  (() => {
    const dialog = document.getElementById('TransferModal');
    if (!dialog) return;

    const transferCode = {{ settings.transfer_modal_code | strip | json }};
    const fallbackPercent = {{ transfer_fallback_percent }};
    const root = window.Shopify.routes.root;
    const codeForm = dialog.querySelector('[data-transfer-code-form]');
    const codeMessage = dialog.querySelector('[data-transfer-code-message]');
    const options = dialog.querySelectorAll('[data-transfer-choice]');
    let pendingButton = null;
    // Set when the modal was opened from "Comprar ahora": the cart line it added, undone on close.
    let addedLine = null;
    let bypass = false;

    const formatMoney = (cents) => '$' + Math.round(cents / 100).toLocaleString('es-AR');
    const sameCode = (a, b) => a.toLowerCase() === b.toLowerCase();
    const setOptionsDisabled = (disabled) => options.forEach((option) => (option.disabled = disabled));

    // GET without a body; POST of a FormData as is, or of an object as JSON.
    const request = (path, body) => {
      const json = body && !(body instanceof FormData);
      return fetch(root + path, {
        method: body ? 'POST' : 'GET',
        headers: json ? { Accept: 'application/json', 'Content-Type': 'application/json' } : { Accept: 'application/json' },
        body: json ? JSON.stringify(body) : body,
      }).then((response) => {
        if (!response.ok) throw new Error(response.status);
        return response.json();
      });
    };

    const appliedCodes = (cart) => (cart.discount_codes || []).filter((discount) => discount.applicable);

    // Read the discount from Scala's config so the modal stays in sync with the app.
    const discountPercent = () => {
      // Scala renders the config inside a <template>, whose content is not part of the document.
      const restrict = document.getElementById('scala-button-restrict');
      const scope = restrict && (restrict.content || restrict);
      const config = scope && scope.querySelector('script[data-kind="config"]');
      const match = config && config.textContent.match(/"discountValue"=>(\d+(?:\.\d+)?)/);
      return match ? parseFloat(match[1]) : fallbackPercent;
    };

    // Scala's button next to this checkout button. Without one (e.g. from "Comprar ahora"), use the
    // one attached to a cart checkout button, like the cart drawer's, which checks out the cart.
    const scalaTrigger = (button) => {
      const all = [...document.querySelectorAll('scala-cart-button')];
      const scala =
        (button && button.parentElement.querySelector('scala-cart-button')) ||
        all.find((element) => element.parentElement.querySelector('[name="checkout"]')) ||
        all[0];
      return scala && scala.shadowRoot && scala.shadowRoot.querySelector('button[data-trigger]');
    };

    const fillPrices = (cart) => {
      const percent = discountPercent();
      // The transfer price starts from the full price: its discount replaces any regular code.
      const full = cart.original_total_price;
      dialog.querySelector('[data-transfer-percent]').textContent = percent;
      dialog.querySelector('[data-transfer-original]').textContent = formatMoney(full);
      dialog.querySelector('[data-transfer-discounted]').textContent = formatMoney(full * (1 - percent / 100));
      dialog.querySelector('[data-transfer-full-original]').textContent =
        cart.total_price < full ? formatMoney(full) : '';
      dialog.querySelector('[data-transfer-full]').textContent = formatMoney(cart.total_price);
    };

    const open = async (button, productForm) => {
      pendingButton = button;
      addedLine = null;
      delete dialog.dataset.codeValid;
      codeForm.reset();
      codeMessage.textContent = '';

      if (productForm) {
        const formData = new FormData(productForm);
        try {
          const line = await request('cart/add.js', formData);
          addedLine = { key: line.key, quantity: line.quantity - (Number(formData.get('quantity')) || 1) };
        } catch (error) {
          // E.g. no more stock: let "Comprar ahora" handle it as if the modal did not exist.
          bypass = true;
          button.click();
          bypass = false;
          return;
        }
      }

      setOptionsDisabled(true);
      // The cart drawer traps focus inside itself, which would pull focus out of the modal.
      if (typeof removeTrapFocus === 'function') removeTrapFocus();
      dialog.showModal();
      try {
        const cart = await request('cart.js');
        // Show a code already on the cart, e.g. one applied from an email link.
        const existing = appliedCodes(cart)[0];
        if (existing) {
          codeForm.elements.discount.value = existing.code;
          codeMessage.textContent = `Código ${existing.code} aplicado.`;
        }
        fillPrices(cart);
      } catch (error) {}
      setOptionsDisabled(false);
    };

    const close = () => {
      dialog.close();
      if (addedLine) {
        request('cart/change.js', { id: addedLine.key, quantity: Math.max(addedLine.quantity, 0) }).catch(() => {});
        addedLine = null;
      }
      const drawer = pendingButton && pendingButton.closest('cart-drawer.active');
      if (drawer && typeof trapFocus === 'function') trapFocus(document.getElementById('CartDrawer'), pendingButton);
    };

    document.addEventListener(
      'click',
      (event) => {
        if (bypass || !scalaTrigger()) return;
        const checkout = event.target.closest('button[name="checkout"], input[name="checkout"]');
        const buyNow = !checkout && event.target.closest('.shopify-payment-button, shopify-buy-it-now-button');
        const button = checkout || buyNow;
        if (!button || button.disabled) return;
        const productForm = buyNow && buyNow.closest('product-form')?.querySelector('form[action*="/cart/add"]');
        if (buyNow && !productForm) return;
        event.preventDefault();
        event.stopImmediatePropagation();
        open(button, productForm);
      },
      true
    );

    dialog.querySelector('[data-transfer-close]').addEventListener('click', close);
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) close();
    });
    dialog.addEventListener('cancel', (event) => {
      event.preventDefault();
      close();
    });

    codeForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      const code = codeForm.elements.discount.value.trim();
      if (!code) return;

      if (transferCode && sameCode(code, transferCode)) {
        dialog.dataset.codeValid = '';
        codeMessage.textContent = `Código ${transferCode} aplicado.`;
        return;
      }

      // Any other code is a regular Shopify code, valid with every payment method.
      delete dialog.dataset.codeValid;
      const submit = codeForm.querySelector('button[type="submit"]');
      submit.disabled = true;
      setOptionsDisabled(true);
      try {
        const previous = appliedCodes(await request('cart.js')).map((discount) => discount.code);
        let cart = await request('cart/update.js', { discount: code });
        const applied = appliedCodes(cart).find((discount) => sameCode(discount.code, code));
        if (applied) {
          codeMessage.textContent = `Código ${applied.code} aplicado.`;
        } else {
          codeMessage.textContent = 'El código ingresado no existe';
          // Put back the code that was there, so a typo does not remove a valid one.
          cart = await request('cart/update.js', { discount: previous.join(',') });
        }
        fillPrices(cart);
      } catch (error) {
        codeMessage.textContent = 'No pudimos aplicar el código. Probá de nuevo.';
      } finally {
        submit.disabled = false;
        setOptionsDisabled(false);
      }
    });

    options.forEach((option) => {
      option.addEventListener('click', async () => {
        if (option.dataset.transferChoice === 'transfer') {
          setOptionsDisabled(true);
          // The transfer discount replaces any regular code instead of stacking with it.
          await request('cart/update.js', { discount: '' }).catch(() => {});
          // Scala navigates to checkout once it has stored the discount on the cart.
          scalaTrigger(addedLine ? null : pendingButton).click();
          return;
        }
        dialog.close();
        if (addedLine) {
          // Opened from "Comprar ahora": the product is in the cart now, so check out the cart.
          window.location.href = root + 'checkout';
          return;
        }
        bypass = true;
        pendingButton.click();
        bypass = false;
      });
    });
  })();
</script>
