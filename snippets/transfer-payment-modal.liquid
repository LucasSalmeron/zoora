{% comment %}
  Opens when the customer presses any checkout button. Controlled by two theme settings (Cart):
  - transfer_modal_ask_payment: ask how they will pay. "Transferencia" delegates to the Scala
    Discounts app button (which applies the discount and leaves only the transfer payment
    method in checkout); the other option continues to the normal checkout. Scala's own
    buttons are hidden so this modal is the only entry point. Needs Scala on the page.
  - transfer_modal_ask_code: offer a field to apply a discount code before paying.
  With neither available, checkout works as usual.
{% endcomment %}

{%- assign transfer_fallback_percent = 10 -%}

<dialog id="TransferModal" class="transfer-modal" aria-labelledby="TransferModal-Title">
  <div class="transfer-modal__content">
    <button type="button" class="transfer-modal__close" data-transfer-close aria-label="Cerrar">
      <svg viewBox="0 0 18 18" width="18" height="18" aria-hidden="true">
        <path d="M2 2l14 14M16 2L2 16" stroke="currentColor" stroke-width="1.5" fill="none"/>
      </svg>
    </button>

    <h2 id="TransferModal-Title" class="transfer-modal__title">
      <span data-payment-only>¿Cómo querés pagar?</span>
      <span data-code-only>¿Tenés un código de descuento?</span>
    </h2>

    {%- if settings.transfer_modal_ask_code -%}
      <form class="transfer-modal__code" data-transfer-code-form>
        <label for="TransferModal-Code" class="visually-hidden">Código de descuento</label>
        <input
          id="TransferModal-Code"
          class="transfer-modal__code-input"
          type="text"
          name="discount"
          placeholder="Código de descuento"
          autocomplete="off"
          autocapitalize="characters"
        >
        <button type="submit" class="transfer-modal__code-button">Aplicar</button>
      </form>
      <p class="transfer-modal__code-message" data-transfer-code-message role="status"></p>
    {%- endif -%}

    <button
      type="button"
      class="transfer-modal__option transfer-modal__option--featured"
      data-transfer-choice="transfer"
      data-payment-only
    >
      <span class="transfer-modal__badge"><span data-transfer-percent>{{ transfer_fallback_percent }}</span>% OFF</span>
      <span class="transfer-modal__label">Transferencia bancaria</span>
      <span class="transfer-modal__price">
        <s data-transfer-original></s>
        <strong data-transfer-discounted></strong>
      </span>
    </button>

    <button type="button" class="transfer-modal__option" data-transfer-choice="other">
      <span class="transfer-modal__label">
        <span data-payment-only>Tarjeta, Mercado Pago u otros medios</span>
        <span data-code-only>Continuar al pago</span>
      </span>
      <span class="transfer-modal__price"><span data-transfer-full></span></span>
    </button>
  </div>
</dialog>

{% style %}
  {%- if settings.transfer_modal_ask_payment -%}
    scala-cart-button {
      display: none !important;
    }
  {%- endif -%}

  .transfer-modal[data-view='payment'] [data-code-only],
  .transfer-modal[data-view='code'] [data-payment-only] {
    display: none !important;
  }

  .transfer-modal {
    width: calc(100% - 32px);
    max-width: 440px;
    padding: 0;
    border: none;
    border-radius: 8px;
    background: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
  }

  .transfer-modal::backdrop {
    background: rgba(0, 0, 0, 0.5);
  }

  .transfer-modal__content {
    position: relative;
    padding: 32px 24px 24px;
  }

  .transfer-modal__close {
    position: absolute;
    top: 12px;
    right: 12px;
    padding: 8px;
    border: none;
    background: none;
    color: inherit;
    cursor: pointer;
  }

  .transfer-modal__title {
    margin: 0 0 20px;
    font-size: 2rem;
    text-align: center;
  }

  .transfer-modal__code {
    display: flex;
    gap: 8px;
  }

  .transfer-modal__code-input {
    flex: 1;
    min-width: 0;
    padding: 10px 12px;
    border: 1px solid rgba(var(--color-foreground), 0.25);
    border-radius: 6px;
    background: none;
    color: inherit;
    font: inherit;
    font-size: 1.4rem;
  }

  .transfer-modal__code-button {
    padding: 10px 16px;
    border: 1px solid rgb(var(--color-foreground));
    border-radius: 6px;
    background: none;
    color: inherit;
    font: inherit;
    font-size: 1.4rem;
    cursor: pointer;
  }

  .transfer-modal__code-button[disabled] {
    opacity: 0.6;
    cursor: wait;
  }

  .transfer-modal__code-message {
    margin: 6px 0 0;
    font-size: 1.3rem;
    color: rgba(var(--color-foreground), 0.75);
  }

  .transfer-modal__code-message:empty {
    display: none;
  }

  .transfer-modal__option {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
    width: 100%;
    margin-top: 12px;
    padding: 16px;
    border: 1px solid rgba(var(--color-foreground), 0.25);
    border-radius: 6px;
    background: none;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition: border-color 0.2s ease;
  }

  .transfer-modal__option:hover {
    border-color: rgb(var(--color-foreground));
  }

  .transfer-modal__option--featured,
  .transfer-modal[data-view='code'] .transfer-modal__option {
    border: 2px solid rgb(var(--color-foreground));
  }

  .transfer-modal__option[disabled] {
    opacity: 0.6;
    cursor: wait;
  }

  .transfer-modal__badge {
    position: absolute;
    top: 14px;
    right: 14px;
    padding: 2px 8px;
    border-radius: 4px;
    background: rgb(var(--color-foreground));
    color: rgb(var(--color-background));
    font-size: 1.2rem;
    letter-spacing: 0.05rem;
  }

  .transfer-modal__label {
    font-size: 1.5rem;
    letter-spacing: 0.04rem;
  }

  .transfer-modal__price {
    display: flex;
    gap: 8px;
    font-size: 1.4rem;
    color: rgba(var(--color-foreground), 0.75);
  }

  .transfer-modal__price strong {
    color: rgb(var(--color-foreground));
  }
{% endstyle %}

<script>
  (() => {
    const dialog = document.getElementById('TransferModal');
    if (!dialog) return;

    const askPayment = {{ settings.transfer_modal_ask_payment | json }};
    const fallbackPercent = {{ transfer_fallback_percent }};
    const codeForm = dialog.querySelector('[data-transfer-code-form]');
    const codeMessage = dialog.querySelector('[data-transfer-code-message]');
    let pendingButton = null;
    let bypass = false;

    const formatMoney = (cents) => '$' + Math.round(cents / 100).toLocaleString('es-AR');

    // Read the discount from Scala's config so the modal stays in sync with the app.
    const discountPercent = () => {
      const config = document.querySelector('#scala-button-restrict script[data-kind="config"]');
      const match = config && config.textContent.match(/"discountValue"=>(\d+(?:\.\d+)?)/);
      return match ? parseFloat(match[1]) : fallbackPercent;
    };

    const scalaTrigger = (button) => {
      const scala =
        button.parentElement.querySelector('scala-cart-button') || document.querySelector('scala-cart-button');
      return scala && scala.shadowRoot && scala.shadowRoot.querySelector('button[data-trigger]');
    };

    // Which view the modal shows for this button, or null to go straight to checkout.
    const viewFor = (button) => {
      if (askPayment && scalaTrigger(button)) return 'payment';
      return codeForm ? 'code' : null;
    };

    const fetchCart = () => fetch(window.Shopify.routes.root + 'cart.js').then((response) => response.json());

    const fillPrices = (cart) => {
      const percent = discountPercent();
      dialog.querySelector('[data-transfer-percent]').textContent = percent;
      const discounted = cart.total_price * (1 - percent / 100);
      dialog.querySelector('[data-transfer-original]').textContent = formatMoney(cart.total_price);
      dialog.querySelector('[data-transfer-discounted]').textContent = formatMoney(discounted);
      dialog.querySelector('[data-transfer-full]').textContent = formatMoney(cart.total_price);
    };

    const open = (button, view) => {
      pendingButton = button;
      dialog.dataset.view = view;
      dialog.querySelectorAll('[data-transfer-choice]').forEach((option) => (option.disabled = false));
      if (codeMessage) codeMessage.textContent = '';
      // The cart drawer traps focus inside itself, which would pull focus out of the modal.
      if (typeof removeTrapFocus === 'function') removeTrapFocus();
      dialog.showModal();
      fetchCart()
        .then((cart) => {
          // Pre-fill a code already on the cart, e.g. one applied from an email link.
          if (codeForm) {
            const existing = (cart.discount_codes || []).find((discount) => discount.applicable);
            codeForm.elements.discount.value = existing ? existing.code : '';
          }
          fillPrices(cart);
        })
        .catch(() => {});
    };

    const close = () => {
      dialog.close();
      const drawer = pendingButton && pendingButton.closest('cart-drawer.active');
      if (drawer && typeof trapFocus === 'function') trapFocus(document.getElementById('CartDrawer'), pendingButton);
    };

    document.addEventListener(
      'click',
      (event) => {
        const button = event.target.closest('button[name="checkout"], input[name="checkout"]');
        if (!button || bypass || button.disabled) return;
        const view = viewFor(button);
        if (!view) return;
        event.preventDefault();
        event.stopImmediatePropagation();
        open(button, view);
      },
      true
    );

    dialog.querySelector('[data-transfer-close]').addEventListener('click', close);
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) close();
    });
    dialog.addEventListener('cancel', (event) => {
      event.preventDefault();
      close();
    });

    if (codeForm) {
      codeForm.addEventListener('submit', async (event) => {
        event.preventDefault();
        const code = codeForm.elements.discount.value.trim();
        if (!code) return;
        const submit = codeForm.querySelector('button[type="submit"]');
        submit.disabled = true;
        try {
          const cart = await fetch(window.Shopify.routes.root + 'cart/update.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ discount: code }),
          }).then((response) => response.json());
          const applied = (cart.discount_codes || []).find(
            (discount) => discount.code.toLowerCase() === code.toLowerCase()
          );
          // Codes limited to a customer segment can't be checked until the customer enters their email.
          codeMessage.textContent =
            applied && applied.applicable
              ? `Código ${applied.code} aplicado.`
              : 'No pudimos aplicar este código ahora. Si es exclusivo para clientes, se valida cuando ingreses tu mail al pagar.';
          fillPrices(cart);
        } catch (error) {
          codeMessage.textContent = 'No pudimos aplicar el código. Probá de nuevo.';
        } finally {
          submit.disabled = false;
        }
      });
    }

    dialog.querySelectorAll('[data-transfer-choice]').forEach((option) => {
      option.addEventListener('click', () => {
        if (option.dataset.transferChoice === 'transfer') {
          // Scala navigates to checkout once it has stored the discount on the cart.
          dialog.querySelectorAll('[data-transfer-choice]').forEach((other) => (other.disabled = true));
          scalaTrigger(pendingButton).click();
          return;
        }
        dialog.close();
        bypass = true;
        pendingButton.click();
        bypass = false;
      });
    });
  })();
</script>
