{{ 'zoora-sections.css' | asset_url | stylesheet_tag }}

{%- assign split = section.settings.split_ratio | default: '1-1' -%}
{%- if split == '2-1' -%}
  {%- assign main_col = '2fr' -%}
  {%- assign side_col = '1fr' -%}
{%- elsif split == '3-2' -%}
  {%- assign main_col = '3fr' -%}
  {%- assign side_col = '2fr' -%}
{%- else -%}
  {%- assign main_col = '1fr' -%}
  {%- assign side_col = '1fr' -%}
{%- endif -%}
{%- assign row_h = section.settings.row_height | default: 44 -%}
{%- assign row_h_tablet = row_h | times: 0.82 | round: 0 -%}
{%- assign partial_h = section.settings.partial_row_height | default: 30 -%}
{%- assign partial_h_tablet = partial_h | times: 0.82 | round: 0 -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  .section-{{ section.id }}-padding .zoora-mosaic-row {
    grid-template-columns: {{ main_col }} {{ side_col }};
    grid-template-rows: {{ row_h }}rem;
  }
  .section-{{ section.id }}-padding .zoora-mosaic-row--reversed {
    grid-template-columns: {{ side_col }} {{ main_col }};
  }
  .section-{{ section.id }}-padding .zoora-mosaic-partial {
    height: {{ partial_h }}rem;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  @media screen and (max-width: 989px) {
    .section-{{ section.id }}-padding .zoora-mosaic-row {
      grid-template-rows: {{ row_h_tablet }}rem;
    }
    .section-{{ section.id }}-padding .zoora-mosaic-partial {
      height: {{ partial_h_tablet }}rem;
    }
  }
  @media screen and (max-width: 749px) {
    .section-{{ section.id }}-padding .zoora-mosaic-card {
      aspect-ratio: 1 / 1;
      height: auto;
    }
    .section-{{ section.id }}-padding .zoora-mosaic-main .zoora-mosaic-card,
    .section-{{ section.id }}-padding .zoora-mosaic-side-item .zoora-mosaic-card {
      height: auto;
    }
    .section-{{ section.id }}-padding .zoora-mosaic-side-item {
      height: auto;
    }
  }
{%- endstyle -%}

{%- assign items_per_row = section.settings.items_per_row | default: 3 | plus: 0 -%}
{%- assign total = section.blocks.size -%}
{%- assign full_rows = total | divided_by: items_per_row -%}
{%- assign remainder = total | modulo: items_per_row -%}
{%- assign cta = section.settings.cta_label | default: 'Ver colección' -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">

    {%- if section.settings.title != blank -%}
      <div class="title-wrapper title-wrapper--no-top-margin">
        <h2 class="title inline-richtext {{ section.settings.heading_size }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
          {{ section.settings.title }}
        </h2>
      </div>
    {%- endif -%}

    <div class="zoora-mosaic">

      {%- if full_rows > 0 -%}
        {%- assign max_row = full_rows | minus: 1 -%}
        {%- for row_idx in (0..max_row) -%}
          {%- assign base = row_idx | times: items_per_row -%}
          {%- assign b1i = base | plus: 1 -%}
          {%- assign b0 = section.blocks[base] -%}
          {%- assign b1 = section.blocks[b1i] -%}
          {%- assign is_rev = row_idx | modulo: 2 -%}

          <div class="zoora-mosaic-row{% if is_rev == 1 %} zoora-mosaic-row--reversed{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">

            <div class="zoora-mosaic-main">
              {%- render 'zoora-mosaic-card', block: b0, cta_label: cta -%}
            </div>

            <div class="zoora-mosaic-side">
              {%- if b1 -%}
                <div class="zoora-mosaic-side-item">
                  {%- render 'zoora-mosaic-card', block: b1, cta_label: cta -%}
                </div>
              {%- endif -%}
              {%- if items_per_row == 3 -%}
                {%- assign b2i = base | plus: 2 -%}
                {%- assign b2 = section.blocks[b2i] -%}
                {%- if b2 -%}
                  <div class="zoora-mosaic-side-item">
                    {%- render 'zoora-mosaic-card', block: b2, cta_label: cta -%}
                  </div>
                {%- endif -%}
              {%- endif -%}
            </div>

          </div>
        {%- endfor -%}
      {%- endif -%}

      {%- if remainder > 0 -%}
        {%- assign rem_start = full_rows | times: items_per_row -%}
        <div class="zoora-mosaic-partial{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
          {%- assign max_rem = remainder | minus: 1 -%}
          {%- for ri in (0..max_rem) -%}
            {%- assign bi = rem_start | plus: ri -%}
            {%- assign br = section.blocks[bi] -%}
            {%- if br -%}
              <div class="zoora-mosaic-partial-item">
                {%- render 'zoora-mosaic-card', block: br, cta_label: cta -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Colecciones",
  "tag": "section",
  "class": "section",
  "max_blocks": 12,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Título",
      "default": "Colecciones"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Tamaño del título",
      "options": [
        { "value": "h2", "label": "Pequeño" },
        { "value": "h1", "label": "Mediano" },
        { "value": "h0", "label": "Grande" }
      ],
      "default": "h2"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Texto del botón",
      "default": "Ver colección"
    },
    {
      "type": "header",
      "content": "Tamaños y distribución"
    },
    {
      "type": "select",
      "id": "items_per_row",
      "label": "Colecciones por fila (escritorio)",
      "options": [
        { "value": "2", "label": "2 por fila — 1 grande + 1 chica" },
        { "value": "3", "label": "3 por fila — 1 grande + 2 chicas" }
      ],
      "default": "3"
    },
    {
      "type": "range",
      "id": "row_height",
      "min": 20,
      "max": 80,
      "step": 2,
      "unit": "rem",
      "label": "Altura de fila (escritorio)",
      "default": 44
    },
    {
      "type": "select",
      "id": "split_ratio",
      "label": "Proporción grande / pequeño",
      "options": [
        { "value": "1-1", "label": "1:1 — Partido al medio" },
        { "value": "2-1", "label": "2:1 — Grande / Pequeño" },
        { "value": "3-2", "label": "3:2 — Grande / Mediano" }
      ],
      "default": "1-1"
    },
    {
      "type": "range",
      "id": "partial_row_height",
      "min": 16,
      "max": 60,
      "step": 2,
      "unit": "rem",
      "label": "Altura fila parcial (1 o 2 colecciones sobrantes)",
      "default": 30
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de color",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Espaciado"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espaciado superior",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espaciado inferior",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "categoria",
      "name": "Colección",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Colección"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen (sobreescribe la imagen de la colección)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título (sobreescribe el nombre de la colección)"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Bajada o subtítulo (opcional)"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link manual (si no usás colección)"
        },
        {
          "type": "select",
          "id": "text_position",
          "label": "Posición del texto",
          "options": [
            { "value": "bottom", "label": "Abajo" },
            { "value": "center", "label": "Centro" },
            { "value": "top", "label": "Arriba" }
          ],
          "default": "bottom"
        },
        {
          "type": "range",
          "id": "image_darkness",
          "min": 0,
          "max": 80,
          "step": 5,
          "unit": "%",
          "label": "Oscurecer imagen",
          "default": 0
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Colecciones",
      "blocks": [
        { "type": "categoria", "settings": { "title": "Decoración" } },
        { "type": "categoria", "settings": { "title": "Iluminación" } },
        { "type": "categoria", "settings": { "title": "Textiles" } }
      ]
    }
  ]
}
{% endschema %}
