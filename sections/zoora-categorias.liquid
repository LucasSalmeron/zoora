{{ 'zoora-sections.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- assign show_carousel = false -%}
{%- if section.blocks.size > 3 -%}
  {%- assign show_carousel = true -%}
{%- endif -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    {%- if section.settings.title != blank -%}
      <div class="title-wrapper title-wrapper--no-top-margin">
        <h2 class="title inline-richtext {{ section.settings.heading_size }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
          {{ section.settings.title }}
        </h2>
      </div>
    {%- endif -%}

    {%- if show_carousel -%}
      <slider-component class="zoora-carousel{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        <ul
          class="zoora-carousel-list grid grid--3-col-desktop grid--2-col-tablet-down slider slider--everywhere grid--peek"
          id="Slider-{{ section.id }}"
          role="list"
        >
          {%- for block in section.blocks -%}
            <li
              class="grid__item slider__slide"
              id="Slide-{{ section.id }}-{{ forloop.index }}"
              {{ block.shopify_attributes }}
            >
              {%- assign cat_url = block.settings.collection.url | default: block.settings.link -%}
              <a
                {% if cat_url != blank %}
                  href="{{ cat_url }}"
                {% else %}
                  role="link" aria-disabled="true"
                {% endif %}
                class="zoora-categoria-card full-unstyled-link"
              >
                <div class="zoora-categoria-media">
                  {%- if block.settings.image != blank -%}
                    {{
                      block.settings.image
                      | image_url: width: 800
                      | image_tag:
                        loading: 'lazy',
                        sizes: '(min-width: 990px) calc((var(--page-width, 1200px) - 10rem) / 3), (min-width: 750px) calc(50vw - 5rem), calc(100vw - 3rem)',
                        widths: '375, 550, 750, 800',
                        alt: block.settings.image.alt
                    }}
                  {%- elsif block.settings.collection.featured_image != blank -%}
                    {{
                      block.settings.collection.featured_image
                      | image_url: width: 800
                      | image_tag:
                        loading: 'lazy',
                        sizes: '(min-width: 990px) calc((var(--page-width, 1200px) - 10rem) / 3), (min-width: 750px) calc(50vw - 5rem), calc(100vw - 3rem)',
                        widths: '375, 550, 750, 800',
                        alt: block.settings.collection.featured_image.alt
                    }}
                  {%- else -%}
                    {%- assign placeholder_index = forloop.index | modulo: 4 | plus: 1 -%}
                    {{- 'collection-apparel-' | append: placeholder_index | placeholder_svg_tag: 'placeholder-svg' -}}
                  {%- endif -%}
                </div>
                {%- assign cat_title = block.settings.title | default: block.settings.collection.title -%}
                {%- if cat_title != blank -%}
                  <p class="zoora-categoria-title">{{ cat_title | escape }}</p>
                {%- endif -%}
              </a>
            </li>
          {%- endfor -%}
        </ul>
        <div class="zoora-carousel-buttons slider-buttons">
          <button
            type="button"
            class="slider-button slider-button--prev"
            name="previous"
            aria-label="{{ 'general.slider.previous_slide' | t }}"
            aria-controls="Slider-{{ section.id }}"
          >
            <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
          </button>
          <div class="slider-counter caption">
            <span class="slider-counter--current">1</span>
            <span aria-hidden="true"> / </span>
            <span class="visually-hidden">{{ 'general.slider.of' | t }}</span>
            <span class="slider-counter--total">{{ section.blocks.size }}</span>
          </div>
          <button
            type="button"
            class="slider-button slider-button--next"
            name="next"
            aria-label="{{ 'general.slider.next_slide' | t }}"
            aria-controls="Slider-{{ section.id }}"
          >
            <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
          </button>
        </div>
      </slider-component>
    {%- else -%}
      <ul class="grid grid--3-col-desktop grid--1-col-tablet-down" role="list">
        {%- for block in section.blocks -%}
          <li
            class="grid__item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
            {% if settings.animations_reveal_on_scroll %}
              data-cascade
              style="--animation-order: {{ forloop.index }};"
            {% endif %}
            {{ block.shopify_attributes }}
          >
            {%- assign cat_url = block.settings.collection.url | default: block.settings.link -%}
            <a
              {% if cat_url != blank %}
                href="{{ cat_url }}"
              {% else %}
                role="link" aria-disabled="true"
              {% endif %}
              class="zoora-categoria-card full-unstyled-link"
            >
              <div class="zoora-categoria-media">
                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 800
                    | image_tag:
                      loading: 'lazy',
                      sizes: '(min-width: 990px) calc((var(--page-width, 1200px) - 10rem) / 3), (min-width: 750px) calc(50vw - 5rem), calc(100vw - 3rem)',
                      widths: '375, 550, 750, 800',
                      alt: block.settings.image.alt
                  }}
                {%- elsif block.settings.collection.featured_image != blank -%}
                  {{
                    block.settings.collection.featured_image
                    | image_url: width: 800
                    | image_tag:
                      loading: 'lazy',
                      sizes: '(min-width: 990px) calc((var(--page-width, 1200px) - 10rem) / 3), (min-width: 750px) calc(50vw - 5rem), calc(100vw - 3rem)',
                      widths: '375, 550, 750, 800',
                      alt: block.settings.collection.featured_image.alt
                  }}
                {%- else -%}
                  {%- assign placeholder_index = forloop.index | modulo: 4 | plus: 1 -%}
                  {{- 'collection-apparel-' | append: placeholder_index | placeholder_svg_tag: 'placeholder-svg' -}}
                {%- endif -%}
              </div>
              {%- assign cat_title = block.settings.title | default: block.settings.collection.title -%}
              {%- if cat_title != blank -%}
                <p class="zoora-categoria-title">{{ cat_title | escape }}</p>
              {%- endif -%}
            </a>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Categorías",
  "tag": "section",
  "class": "section",
  "max_blocks": 12,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Título",
      "default": "Categorías"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Tamaño del título",
      "options": [
        { "value": "h2", "label": "Pequeño" },
        { "value": "h1", "label": "Mediano" },
        { "value": "h0", "label": "Grande" }
      ],
      "default": "h2"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de color",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Espaciado"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espaciado superior",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espaciado inferior",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "categoria",
      "name": "Categoría",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Colección"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen (opcional, sobreescribe la imagen de la colección)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título (opcional, sobreescribe el nombre de la colección)"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link manual (si no usás colección)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Categorías",
      "blocks": [
        { "type": "categoria", "settings": { "title": "Categoría 1" } },
        { "type": "categoria", "settings": { "title": "Categoría 2" } },
        { "type": "categoria", "settings": { "title": "Categoría 3" } }
      ]
    }
  ]
}
{% endschema %}
