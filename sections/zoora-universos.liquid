{{ 'zoora-sections.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .zoora-universos-{{ section.id }} .zoora-universo-item {
    min-height: {{ section.settings.section_height }};
  }
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  @media screen and (max-width: 749px) {
    .zoora-universos-{{ section.id }} .zoora-universo-item {
      min-height: {{ section.settings.section_height_mobile }};
    }
  }
{%- endstyle -%}

<div class="zoora-universos zoora-universos-{{ section.id }} section-{{ section.id }}-padding">
  {%- if section.settings.title != blank -%}
    <div class="page-width">
      <div class="title-wrapper title-wrapper--no-top-margin">
        <h2 class="title inline-richtext {{ section.settings.heading_size }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
          {{ section.settings.title }}
        </h2>
      </div>
    </div>
  {%- endif -%}
  <div class="zoora-universos__grid">
    {%- for block in section.blocks -%}
      {%- if block.settings.link != blank -%}
        <a href="{{ block.settings.link }}" class="zoora-universo-item zoora-universo-item--link" {{ block.shopify_attributes }}>
      {%- else -%}
        <div class="zoora-universo-item" {{ block.shopify_attributes }}>
      {%- endif -%}

        <div class="zoora-universo-item__media">
          {%- if block.settings.image != blank -%}
            {{
              block.settings.image
              | image_url: width: 1500
              | image_tag:
                loading: forloop.first | if: 'eager', 'lazy',
                sizes: '(min-width: 750px) 50vw, 100vw',
                widths: '375, 550, 750, 1100, 1500',
                alt: block.settings.image.alt
            }}
          {%- else -%}
            {{- 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' -}}
          {%- endif -%}
        </div>

        <div
          class="zoora-universo-item__overlay"
          style="opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};"
          aria-hidden="true"
        ></div>

      {%- if block.settings.link != blank -%}
        </a>
      {%- else -%}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Universos",
  "tag": "section",
  "class": "section",
  "max_blocks": 4,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Título",
      "default": "Nuestros Universos"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Tamaño del título",
      "options": [
        { "value": "h2", "label": "Pequeño" },
        { "value": "h1", "label": "Mediano" },
        { "value": "h0", "label": "Grande" }
      ],
      "default": "h1"
    },
    {
      "type": "select",
      "id": "section_height",
      "label": "Altura en desktop",
      "options": [
        { "value": "380px", "label": "Pequeña" },
        { "value": "500px", "label": "Mediana" },
        { "value": "620px", "label": "Grande" }
      ],
      "default": "500px"
    },
    {
      "type": "select",
      "id": "section_height_mobile",
      "label": "Altura en mobile",
      "options": [
        { "value": "260px", "label": "Pequeña" },
        { "value": "320px", "label": "Mediana" },
        { "value": "420px", "label": "Grande" }
      ],
      "default": "320px"
    },
    {
      "type": "header",
      "content": "Espaciado"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espaciado superior",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espaciado inferior",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "universo",
      "name": "Universo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Enlace al hacer clic"
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "min": 0,
          "max": 80,
          "step": 5,
          "unit": "%",
          "label": "Oscuridad del overlay",
          "default": 0
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Universos",
      "blocks": [
        { "type": "universo" },
        { "type": "universo" }
      ]
    }
  ]
}
{% endschema %}
