{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}
{{ 'template-collection.css' | asset_url | stylesheet_tag }}
{{ 'zoora-sections.css' | asset_url | stylesheet_tag }}

{%- unless section.settings.quick_add == 'none' -%}
  {{ 'quick-add.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- endunless -%}

{%- if section.settings.quick_add == 'standard' -%}
  <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} isolate gradient">
  <div class="page-width section-{{ section.id }}-padding">
    {%- if section.settings.title != blank -%}
      <div class="title-wrapper title-wrapper--no-top-margin">
        <h2 class="title inline-richtext {{ section.settings.heading_size }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
          {{ section.settings.title }}
        </h2>
      </div>
    {%- endif -%}

    <slider-component class="zoora-carousel zoora-products-carousel{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      <button type="button" class="zoora-carousel-btn slider-button slider-button--prev" name="previous" aria-label="{{ 'general.slider.previous_slide' | t }}" aria-controls="Slider-{{ section.id }}">
        <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
      </button>
      {%- assign skip_styles = false -%}
      <ul
        class="grid product-grid contains-card contains-card--product{% if settings.card_style == 'standard' %} contains-card--standard{% endif %} grid--4-col-desktop grid--2-col-tablet-down slider slider--everywhere zoora-carousel-list"
        id="Slider-{{ section.id }}"
        role="list"
      >
        {%- for block in section.blocks -%}
          <li
            class="grid__item slider__slide"
            id="Slide-{{ section.id }}-{{ forloop.index }}"
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.product != blank -%}
              {% render 'card-product',
                card_product: block.settings.product,
                media_aspect_ratio: section.settings.image_ratio,
                image_shape: 'default',
                lazy_load: forloop.index > 2,
                show_secondary_image: section.settings.show_secondary_image,
                show_vendor: false,
                show_rating: false,
                skip_styles: skip_styles,
                section_id: section.id,
                quick_add: section.settings.quick_add,
                card_button_style: section.settings.button_style
              %}
            {%- else -%}
              {%- assign placeholder_image = 'product-apparel-' | append: forloop.index -%}
              {% render 'card-product',
                media_aspect_ratio: section.settings.image_ratio,
                image_shape: 'default',
                lazy_load: false,
                placeholder_image: placeholder_image,
                skip_styles: skip_styles
              %}
            {%- endif -%}
          </li>
          {%- assign skip_styles = true -%}
        {%- endfor -%}
      </ul>
      <button type="button" class="zoora-carousel-btn slider-button slider-button--next" name="next" aria-label="{{ 'general.slider.next_slide' | t }}" aria-controls="Slider-{{ section.id }}">
        <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
      </button>
    </slider-component>

    {%- if section.settings.button_label != blank or section.settings.view_all_collection != blank -%}
      <div class="center{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}" style="margin-top: 2.5rem; display: flex; gap: 1.2rem; justify-content: center; flex-wrap: wrap;">
        {%- if section.settings.button_label != blank -%}
          <a
            {% if section.settings.button_link != blank %}
              href="{{ section.settings.button_link }}"
            {% else %}
              role="link" aria-disabled="true"
            {% endif %}
            class="button button--secondary"
          >
            {{ section.settings.button_label | escape }}
          </a>
        {%- endif -%}
        {%- if section.settings.view_all_collection != blank -%}
          <a href="{{ section.settings.view_all_collection.url }}" class="button button--secondary">
            {{ section.settings.view_all_label | default: 'Ver todos los productos' | escape }}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "4 Productos destacados",
  "tag": "section",
  "class": "section",
  "max_blocks": 8,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Título",
      "default": "Productos destacados"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Tamaño del título",
      "options": [
        { "value": "h2", "label": "Pequeño" },
        { "value": "h1", "label": "Mediano" },
        { "value": "h0", "label": "Grande" }
      ],
      "default": "h1"
    },
    {
      "type": "header",
      "content": "Tarjetas de producto"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Proporción de imagen",
      "options": [
        { "value": "adapt", "label": "Adaptable" },
        { "value": "portrait", "label": "Vertical" },
        { "value": "square", "label": "Cuadrado" }
      ],
      "default": "square"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "label": "Segunda imagen al pasar el mouse",
      "default": true
    },
    {
      "type": "select",
      "id": "quick_add",
      "label": "Botón «Agregar al carrito»",
      "options": [
        { "value": "none", "label": "Sin botón" },
        { "value": "standard", "label": "Mostrar botón" }
      ],
      "default": "standard"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Estilo del botón",
      "options": [
        { "value": "outline", "label": "Contorno" },
        { "value": "solid", "label": "Sólido" }
      ],
      "default": "outline",
      "info": "Solo aplica cuando el botón está activado"
    },
    {
      "type": "header",
      "content": "Botón de acción"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto del botón",
      "info": "Dejá en blanco para ocultar el botón"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Link del botón"
    },
    {
      "type": "header",
      "content": "Botón — Ver todos"
    },
    {
      "type": "collection",
      "id": "view_all_collection",
      "label": "Colección de destino"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "Texto del botón",
      "default": "Ver todos los productos"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de color",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Espaciado"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espaciado superior",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espaciado inferior",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Producto",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Producto"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "4 Productos destacados",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}
