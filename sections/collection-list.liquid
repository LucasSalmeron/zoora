{{ 'zoora-sections.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- assign cols_desktop = section.settings.columns_desktop | default: 3 | plus: 0 -%}
{%- assign cols_mobile  = section.settings.columns_mobile  | default: 2 | plus: 0 -%}

{%- assign show_carousel = false -%}
{%- if section.blocks.size > cols_desktop -%}
  {%- assign show_carousel = true -%}
{%- endif -%}

{%- if cols_desktop == 2 -%}
  {%- assign img_sizes = '(min-width: 990px) calc((var(--page-width, 1600px) - 8rem) / 2), ' -%}
{%- else -%}
  {%- assign img_sizes = '(min-width: 990px) calc((var(--page-width, 1600px) - 10rem) / 3), ' -%}
{%- endif -%}
{%- if cols_mobile == 1 -%}
  {%- assign img_sizes = img_sizes | append: '(min-width: 750px) calc(100vw - 5rem), calc(100vw - 3rem)' -%}
{%- else -%}
  {%- assign img_sizes = img_sizes | append: '(min-width: 750px) calc(50vw - 5rem), calc(50vw - 2rem)' -%}
{%- endif -%}

{%- assign grid_desktop_class = 'grid--' | append: cols_desktop | append: '-col-desktop' -%}
{%- assign grid_mobile_class  = 'grid--' | append: cols_mobile  | append: '-col-tablet-down' -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    {%- unless section.settings.title == blank -%}
      <div class="title-wrapper title-wrapper--no-top-margin">
        <h2
          class="title inline-richtext {{ section.settings.heading_size }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
        >
          {{ section.settings.title }}
        </h2>
      </div>
    {%- endunless -%}

    {%- if show_carousel -%}
      <slider-component class="zoora-carousel{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        <button type="button" class="zoora-carousel-btn slider-button slider-button--prev" name="previous" aria-label="{{ 'general.slider.previous_slide' | t }}" aria-controls="Slider-{{ section.id }}">
          <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
        </button>
        <ul
          class="zoora-carousel-list grid {{ grid_desktop_class }} {{ grid_mobile_class }} slider slider--everywhere"
          id="Slider-{{ section.id }}"
          role="list"
        >
          {%- for block in section.blocks -%}
            <li
              class="grid__item slider__slide"
              id="Slide-{{ section.id }}-{{ forloop.index }}"
              {{ block.shopify_attributes }}
            >
              {%- assign collection = block.settings.collection -%}
              <a
                href="{{ collection.url | default: routes.collections_url }}"
                class="zoora-categoria-card full-unstyled-link"
              >
                <div class="zoora-categoria-media">
                  {%- if collection.featured_image != blank -%}
                    {{
                      collection.featured_image
                      | image_url: width: 800
                      | image_tag:
                        loading: 'lazy',
                        sizes: img_sizes,
                        widths: '375, 550, 750, 800',
                        alt: collection.featured_image.alt | default: collection.title
                    }}
                  {%- else -%}
                    {%- assign placeholder_index = forloop.index | modulo: 4 | plus: 1 -%}
                    {{- 'collection-apparel-' | append: placeholder_index | placeholder_svg_tag: 'placeholder-svg' -}}
                  {%- endif -%}
                </div>
                <p class="zoora-categoria-title">{{ collection.title | default: 'Colección' | escape }}</p>
              </a>
            </li>
          {%- endfor -%}
        </ul>
        <button type="button" class="zoora-carousel-btn slider-button slider-button--next" name="next" aria-label="{{ 'general.slider.next_slide' | t }}" aria-controls="Slider-{{ section.id }}">
          <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
        </button>
      </slider-component>
    {%- else -%}
      <ul class="grid {{ grid_desktop_class }} {{ grid_mobile_class }}" role="list">
        {%- for block in section.blocks -%}
          <li
            class="grid__item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
            {% if settings.animations_reveal_on_scroll %}
              data-cascade
              style="--animation-order: {{ forloop.index }};"
            {% endif %}
            {{ block.shopify_attributes }}
          >
            {%- assign collection = block.settings.collection -%}
            <a
              href="{{ collection.url | default: routes.collections_url }}"
              class="zoora-categoria-card full-unstyled-link"
            >
              <div class="zoora-categoria-media">
                {%- if collection.featured_image != blank -%}
                  {{
                    collection.featured_image
                    | image_url: width: 800
                    | image_tag:
                      loading: 'lazy',
                      sizes: img_sizes,
                      widths: '375, 550, 750, 800',
                      alt: collection.featured_image.alt | default: collection.title
                  }}
                {%- else -%}
                  {%- assign placeholder_index = forloop.index | modulo: 4 | plus: 1 -%}
                  {{- 'collection-apparel-' | append: placeholder_index | placeholder_svg_tag: 'placeholder-svg' -}}
                {%- endif -%}
              </div>
              <p class="zoora-categoria-title">{{ collection.title | default: 'Colección' | escape }}</p>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if section.settings.show_view_all -%}
      <div class="center{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}" style="margin-top: 2.5rem;">
        <a href="{{ routes.collections_url }}" class="button button--secondary">
          {{- 'sections.collection_list.view_all' | t -}}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.collection-list.name",
  "tag": "section",
  "class": "section section-collection-list",
  "max_blocks": 15,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "t:sections.collection-list.settings.title.default",
      "label": "t:sections.collection-list.settings.title.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Columnas en escritorio",
      "options": [
        { "value": "2", "label": "2 columnas" },
        { "value": "3", "label": "3 columnas" }
      ],
      "default": "3"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columnas en mobile",
      "options": [
        { "value": "1", "label": "1 columna" },
        { "value": "2", "label": "2 columnas" }
      ],
      "default": "2"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "default": false,
      "label": "t:sections.collection-list.settings.show_view_all.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "featured_collection",
      "name": "t:sections.collection-list.blocks.featured_collection.name",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "t:sections.collection-list.blocks.featured_collection.settings.collection.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.collection-list.presets.name",
      "blocks": [
        { "type": "featured_collection" },
        { "type": "featured_collection" },
        { "type": "featured_collection" }
      ]
    }
  ]
}
{% endschema %}
