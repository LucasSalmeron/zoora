{{ 'zoora-sections.css' | asset_url | stylesheet_tag }}

{%- assign icon_sz = section.settings.icon_size | default: 8 -%}
{%- assign icon_sz_mobile = icon_sz | times: 0.8 | round: 1 -%}
{%- assign emoji_sz = icon_sz | times: 0.4 | round: 1 -%}
{%- assign emoji_sz_mobile = icon_sz | times: 0.325 | round: 1 -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    --items-per-row: {{ section.settings.items_per_row }};
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  .section-{{ section.id }}-padding .zoora-cat-icons-circle {
    width: {{ icon_sz }}rem;
    height: {{ icon_sz }}rem;
  }
  .section-{{ section.id }}-padding .zoora-cat-icons-emoji {
    font-size: {{ emoji_sz }}rem;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  @media screen and (max-width: 749px) {
    .section-{{ section.id }}-padding {
      --items-per-row: {{ section.settings.items_per_row_mobile }};
    }
    .section-{{ section.id }}-padding .zoora-cat-icons-circle {
      width: {{ icon_sz_mobile }}rem;
      height: {{ icon_sz_mobile }}rem;
    }
    .section-{{ section.id }}-padding .zoora-cat-icons-emoji {
      font-size: {{ emoji_sz_mobile }}rem;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    {%- if section.settings.title != blank -%}
      <div class="title-wrapper title-wrapper--no-top-margin">
        <h2 class="title inline-richtext {{ section.settings.heading_size }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
          {{ section.settings.title }}
        </h2>
      </div>
    {%- endif -%}

    <ul class="zoora-cat-icons-grid" role="list">
      {%- for block in section.blocks -%}
        {%- assign cat_url = block.settings.collection.url | default: block.settings.link -%}
        {%- assign cat_title = block.settings.title | default: block.settings.collection.title -%}
        <li
          class="zoora-cat-icons-item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
          {% if settings.animations_reveal_on_scroll %}
            data-cascade
            style="--animation-order: {{ forloop.index }};"
          {% endif %}
          {{ block.shopify_attributes }}
        >
          <a
            {% if cat_url != blank %}
              href="{{ cat_url }}"
            {% else %}
              role="link" aria-disabled="true"
            {% endif %}
            class="zoora-cat-icons-link full-unstyled-link"
            {% if cat_title != blank %}aria-label="{{ cat_title | escape }}"{% endif %}
          >
            <div class="zoora-cat-icons-circle">
              {%- if block.settings.icon_image != blank -%}
                {{
                  block.settings.icon_image
                  | image_url: width: 200
                  | image_tag:
                    loading: 'lazy',
                    widths: '100, 200',
                    alt: cat_title
                }}
              {%- elsif block.settings.collection.featured_image != blank -%}
                {{
                  block.settings.collection.featured_image
                  | image_url: width: 200
                  | image_tag:
                    loading: 'lazy',
                    widths: '100, 200',
                    alt: cat_title
                }}
              {%- elsif block.settings.emoji != blank -%}
                <span class="zoora-cat-icons-emoji" aria-hidden="true">{{ block.settings.emoji }}</span>
              {%- else -%}
                {%- assign placeholder_index = forloop.index | modulo: 4 | plus: 1 -%}
                {{- 'collection-apparel-' | append: placeholder_index | placeholder_svg_tag: 'placeholder-svg' -}}
              {%- endif -%}
            </div>
            {%- if cat_title != blank -%}
              <p class="zoora-cat-icons-name">{{ cat_title | escape }}</p>
            {%- endif -%}
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Categorías (íconos)",
  "tag": "section",
  "class": "section",
  "max_blocks": 16,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Título",
      "default": "Categorías"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Tamaño del título",
      "options": [
        { "value": "h2", "label": "Pequeño" },
        { "value": "h1", "label": "Mediano" },
        { "value": "h0", "label": "Grande" }
      ],
      "default": "h2"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de color",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Distribución"
    },
    {
      "type": "range",
      "id": "items_per_row",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Categorías por fila (escritorio)",
      "default": 6
    },
    {
      "type": "range",
      "id": "items_per_row_mobile",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Categorías por fila (móvil)",
      "default": 3
    },
    {
      "type": "header",
      "content": "Tamaño del ícono"
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 4,
      "max": 16,
      "step": 0.5,
      "unit": "rem",
      "label": "Tamaño del círculo (escritorio)",
      "info": "En móvil se reduce automáticamente al 80%",
      "default": 8
    },
    {
      "type": "header",
      "content": "Espaciado"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espaciado superior",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espaciado inferior",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "categoria",
      "name": "Categoría",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Colección"
        },
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Ícono (imagen PNG/SVG, sobreescribe la imagen de la colección)"
        },
        {
          "type": "text",
          "id": "emoji",
          "label": "Ícono (emoji, se usa si no hay imagen)",
          "default": "🛍️"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Nombre (sobreescribe el nombre de la colección)"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link manual (si no usás colección)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Categorías (íconos)",
      "blocks": [
        { "type": "categoria", "settings": { "emoji": "👗", "title": "Ropa" } },
        { "type": "categoria", "settings": { "emoji": "👟", "title": "Calzado" } },
        { "type": "categoria", "settings": { "emoji": "👜", "title": "Carteras" } },
        { "type": "categoria", "settings": { "emoji": "💍", "title": "Accesorios" } },
        { "type": "categoria", "settings": { "emoji": "🧴", "title": "Belleza" } },
        { "type": "categoria", "settings": { "emoji": "🏠", "title": "Hogar" } }
      ]
    }
  ]
}
{% endschema %}
